<?xml version="1.0" encoding="utf-8"?>
<!--
    Copias de seguridad: ninguna.

    El estado de la app (contraseña, pepper, contenido en curso) no debe salir
    del dispositivo por la vía que controle el usuario sin querer, y mucho menos
    por la nube. `allowBackup="false"` ya cubre las copias antiguas; estas reglas
    son las que pide Android 12+ y son las que de verdad se aplican en dispositivos
    recientes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>